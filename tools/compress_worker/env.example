# 漫读压缩 Worker 环境变量配置
# 用法：复制本文件为 env（无扩展名），与 compress_worker.exe、启动脚本放同一目录。
# 只支持 KEY=VALUE 行；# 或 ; 开头为注释；值可加引号；export 前缀可省略。

# ---- 桶连接（必填，与 App 用的同一套最小权限凭证）----
BUCKET_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
BUCKET_NAME=your-bucket
BUCKET_AK=yourAccessKey
BUCKET_SK=yourSecretKey

# ---- 可选项（按需取消注释）----
# BUCKET_REGION=oss-cn-hangzhou
# BUCKET_PORT=443
# BUCKET_SSL=true

# ffmpeg 不在 PATH 时填绝对路径（调试/排障先看错误日志里报不报这个）
# FFMPEG=D:\tools\ffmpeg\bin\ffmpeg.exe

# 调度：默认每日 SCHEDULE_AT 点干活（本地时间，默认 02:00 不用写）；
# 设了 INTERVAL_MINUTES 则改为固定间隔轮询；ONESHOT=1 只跑一轮（调试常用）。
# SCHEDULE_AT=02:00
# INTERVAL_MINUTES=30
# ONESHOT=1
